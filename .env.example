ALLOWED_ORIGIN=
CASE_TIMEOUT_MS=
GEMINI_API_KEY=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
LOG_LEVEL=
MAX_CONCURRENT_JOBS=
OPENFOAM_EXEC_MODE=
# In development, missing OpenFOAM binaries use the clearly labelled aerodynamic
# surrogate so the local workbench remains testable. Set false to fail fast.
OPENFOAM_FALLBACK=true

# Local development can run the simulation endpoints without opening a login popup.
# For production, set this explicitly only if public guest simulation access is intended.
ALLOW_GUEST_SIMULATIONS=true

# Frontend build-time variable. Leave empty for local same-origin development.
# For Vercel, set this to the public URL of the separate OpenFOAM backend.
VITE_API_BASE_URL=

# Optional frontend environment label, for diagnostics only.
VITE_APP_ENV=local
